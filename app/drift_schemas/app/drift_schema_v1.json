          "sql": "CREATE TABLE IF NOT EXISTS \"edizioni\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"opera_id\" INTEGER NOT NULL REFERENCES opere (id), \"serie_id\" INTEGER NULL REFERENCES serie (id), \"publisher\" TEXT NULL, \"issue_number\" INTEGER NULL, \"issue_number_label\" TEXT NULL, \"cover_image\" TEXT NULL, \"created_at\" TEXT NOT NULL);"
